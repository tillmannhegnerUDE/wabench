Native = ${Benchmark}
WASM = ${Benchmark}.wasm

ifeq ($(SRCSUFFIX),rs)
	SRC = $(wildcard $(SRCDIR)/*.rs)
	RS = $(SRC)
	OBJ =
else
	SRC = $(wildcard ${SRCDIR}/*.${SRCSUFFIX})
	RSS =
	OBJ = $(SRC:.${SRCSUFFIX}=.o)
endif

CLANG = clang

ifeq (${SRCSUFFIX}, $(filter ${SRCSUFFIX}, cc cpp))
    CLANG = clang++
endif

CC = /usr/bin/${CLANG}
RUSTC = /root/.cargo/bin/rustc

OPT=-O${OPTLEVEL}

$(info The opt level is: ${OPTLEVEL} and its variable is ${OPT})

WASMCC = /opt/wasi-sdk-33.0-x86_64-linux/bin/${CLANG} \
         --sysroot /opt/wasi-sdk-33.0-x86_64-linux/share/wasi-sysroot

all: ${Native} ${WASM}

%.o: %.${SRCSUFFIX}
	${CC} ${CFLAGS} ${OPT} ${CINCLUDE} -c $< -o $@

${Native}: ${OBJ} ${RS}
	@if [ -n "${OBJ}" ]; then \
		${CC} ${CFLAGS} ${OPT} ${OBJ} ${LDFLAGS} -v -o $@; \
	elif [ -n "${RS}" ]; then \
		${RUSTC} -C opt-level=${OPTLEVEL} -C overflow_checks=yes ${RS} -o $@; \
	else \
		echo "Error: No source files to compile to native executable"; \
		exit 1; \
	fi

${WASM}: ${SRC}
	@if [ -n "${OBJ}" ]; then \
		${WASMCC} ${CFLAGS} ${WASMFLAGS} ${OPT} ${CINCLUDE} $^ -o $@; \
	elif [ -n "${RS}" ]; then \
		${RUSTC} -C opt-level=${OPTLEVEL} -C overflow_checks=yes --target wasm32-wasip1 $^ -o $@; \
	else \
		@echo "Error: No source files to compile to wasm module"; \
		exit 1; \
	fi

clean:
	@echo "Cleaning up..."
	rm -rf ${OBJ} ${Native} ${WASM} ${TEMPFILE} *.cwasm output_*
