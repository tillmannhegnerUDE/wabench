Native = ${Benchmark}
WASM = ${Benchmark}.wasm

SRC = $(wildcard ${SRCDIR}/*.${SRCSUFFIX})
OBJ = $(SRC:.${SRCSUFFIX}=.o)

CLANG = clang

ifeq (${SRCSUFFIX}, $(filter ${SRCSUFFIX}, cc cpp))
    CLANG = clang++
endif

CC = /usr/bin/${CLANG}

OPT=-O2

WASMCC = /home/wasi-sdk-10.0/bin/${CLANG} \
         --sysroot /wasi-sdk-10.0/share/wasi-sysroot

all: ${Native} ${WASM}

%.o: %.${SRCSUFFIX}
	${CC} -I/usr/include/x86_64-linux-gnu ${CFLAGS} ${OPT} ${CINCLUDE} -c $< -o $@

${Native}: ${OBJ}
	${CC} -I/usr/include/x86_64-linux-gnu ${CFLAGS} ${OPT} $^ ${LDFLAGS} -v -o $@

${WASM}: ${SRC}
	${WASMCC} ${CFLAGS} ${OPT} ${CINCLUDE} $^ -o $@

clean:
	@echo "Cleaning up..."
	rm -rf ${OBJ} ${Native} ${WASM} ${TEMPFILE} *.cwasm output_*
